{
  "version": 2,
  "buildCommand": "npm run build && npm run build:ssr",
  "outputDirectory": "dist/app/browser",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/app/server/**"
    }
  },
  "routes": [
    {
      "src": "/webfonts/(.*)",
      "dest": "/webfonts/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/tinymce/(.*)",
      "dest": "/tinymce/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|svg|woff|woff2|ttf|eot|webmanifest|txt|map))",
      "dest": "/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
